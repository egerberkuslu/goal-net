# Copy to .env (gitignored) and fill in. docker-compose.yml reads this file.

# --- TURN shared secret (required) ------------------------------------------
# Generate a fresh one, never reuse it across environments:
#   openssl rand -hex 32
# Both the web service and coturn need the same value: the web service signs
# ephemeral credentials with it, coturn verifies them. It must never be sent
# to a browser, only the derived base64 HMAC is.
TURN_SECRET=

# --- TURN identity ----------------------------------------------------------
# realm goes into the credential challenge; it must match on both sides.
TURN_REALM=goalnet.local
# Hostname the browser dials. Localhost for dev; in production use the name on
# the TLS certificate, otherwise the turns: candidate is rejected.
TURN_HOST=127.0.0.1
TURN_PORT=3478
TURN_TLS_PORT=5349
# Credential lifetime in seconds. 300 matches the spec.
TURN_TTL=300

# --- coturn binding ---------------------------------------------------------
# Dev: loopback only, so nothing leaks onto the LAN.
# Production: 0.0.0.0 here, and set TURN_EXTERNAL_IP to the public address
# (needed when the box sits behind NAT, e.g. most cloud VMs with an elastic IP).
TURN_LISTENING_IP=127.0.0.1
TURN_RELAY_IP=
TURN_EXTERNAL_IP=
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535
TURN_TOTAL_QUOTA=100

# --- web service ------------------------------------------------------------
# Host port for the static/API service. 5199 is vite, 5200 is the standalone
# room list, so those two stay free.
WEB_PORT=5210
# 1 serves index.html for extension-less unknown paths. Leave 0 unless you move
# off hash routing: it turns broken asset links into silent 200s.
SPA_FALLBACK=0
